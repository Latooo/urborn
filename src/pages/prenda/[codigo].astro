---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Campana from '../../components/Campana.astro';
import FotoPrenda from '../../components/FotoPrenda.astro';
import { trazoWhatsapp } from '../../lib/iconos';
import Precio from '../../components/Precio.astro';
import { PRECIOS_VISIBLES, coleccion, enlaceWhatsapp, formatoPrecio, mensajePedido, type Producto } from '../../data/productos';
import { marca } from '../../data/sitio';
import { ruta } from '../../lib/rutas';

// Una página por prenda: /prenda/000/, /prenda/001/...
export function getStaticPaths() {
  return coleccion.productos.map((producto) => ({
    params: { codigo: producto.codigo },
    props: { producto },
  }));
}

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const otras = coleccion.productos.filter((otra) => otra.codigo !== producto.codigo);

// El enlace a esta página va dentro del mensaje para que quien atiende sepa qué prenda es.
const estaPagina = Astro.site ? Astro.url.href : undefined;
const pedido = (talla?: string) => enlaceWhatsapp(mensajePedido(producto, talla, estaPagina));

const anchos = [480, 720, 960, 1280, 1600];
// Computador: dos vistas dentro del 60 % de la pantalla, menos márgenes. Celular: la fila que se desliza.
const tamanos = '(min-width: 60rem) 27vw, 72vw';

---

<Base
  titulo={`${producto.nombre} — ${marca.nombre}`}
  descripcion={`${producto.nombre} de la colección ${coleccion.nombre}${PRECIOS_VISIBLES ? `, ${formatoPrecio(producto.precio)}` : ''}. Pedidos por WhatsApp.`}
>
  <Cabecera />

  <main class="ficha" id="contenido">
    <!--
      Una mitad con la prenda, sobre Bone como en la colección, y la otra con los datos, sobre Asphalt.
    -->
    <div class="principal">
      <div class="galeria" id="inicio">
        <figure style={`view-transition-name: prenda-${producto.codigo}`}>
          <figcaption>frente</figcaption>
          <FotoPrenda
            src={producto.frente}
            alt={`${producto.nombre}, vista de frente`}
            widths={anchos}
            sizes={tamanos}
            priority
          />
        </figure>
        <figure>
          <figcaption>espalda</figcaption>
          <FotoPrenda
            src={producto.espalda}
            alt={`${producto.nombre}, vista de espalda`}
            widths={anchos}
            sizes={tamanos}
            loading="eager"
          />
        </figure>
      </div>

      <div class="datos">
        <h1 class="titulo">{producto.nombre}</h1>
        <Precio valor={producto.precio} />
        <p class="descripcion">{producto.descripcion}</p>

        <fieldset class="tallas">
          <legend>Talla</legend>
          {
            producto.tallas.map((talla) => (
              <label>
                <input type="radio" name="talla" value={talla} data-enlace={pedido(talla)} />
                <span>{talla}</span>
              </label>
            ))
          }
        </fieldset>

        <a class="pedir" href={pedido()} target="_blank" rel="noopener" data-pedido>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={trazoWhatsapp}></path></svg>
          Pedir por WhatsApp
        </a>
        <p class="nota">Se abre el chat de URBORN con tu pedido ya escrito.</p>
      </div>
    </div>

    {
      /* La foto de campaña solo va en la prenda que sale en ella. */
      producto.enCampana && (
        <section class="puesta" aria-labelledby="titulo-puesta">
          <h2 class="titulo" id="titulo-puesta" data-revelar="mascara">
            <span>Así se ve puesta</span>
          </h2>
          <Campana />
        </section>
      )
    }

    <section class="otras" aria-labelledby="titulo-otras">
      <h2 class="titulo" id="titulo-otras" data-revelar="mascara"><span>Más de {coleccion.nombre}</span></h2>
      <ul>
        {
          otras.map((otra) => (
            <li>
              <Tarjeta producto={otra} tamanos="(min-width: 60rem) 18vw, 42vw" />
            </li>
          ))
        }
      </ul>
      <a class="volver" href={ruta('#coleccion')} data-revelar>Ver toda la colección</a>
    </section>
  </main>

  <Pie />
</Base>

<script>
  // Al elegir talla, el botón de WhatsApp lleva el mensaje con esa talla.
  const boton = document.querySelector<HTMLAnchorElement>('[data-pedido]');

  for (const opcion of document.querySelectorAll<HTMLInputElement>('input[name="talla"]')) {
    opcion.addEventListener('change', () => {
      if (boton && opcion.checked && opcion.dataset.enlace) boton.href = opcion.dataset.enlace;
    });
    // Si el navegador recordó una talla marcada al volver atrás, el botón debe coincidir.
    if (boton && opcion.checked && opcion.dataset.enlace) boton.href = opcion.dataset.enlace;
  }
</script>

<style>
  .ficha {
    background: var(--negro);
  }

  /* Galería en Bone (igual que la colección) y datos en Asphalt. */
  .principal {
    --galeria-fondo: var(--hueso);
    --galeria-tenue: var(--tenue-claro);
    --datos-fondo: var(--asfalto);
    --datos-texto: var(--hueso);
    --datos-tenue: var(--tenue-oscuro);
    --talla-fondo: #3d4046; /* un paso más claro que Asphalt */
    display: grid;
  }

  /* Celular: frente y espalda en una fila que se desliza; la segunda prenda asoma a propósito. */
  .galeria {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 28rem);
    gap: 3vw;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margen);
    padding: clamp(1.25rem, 4vw, 2.5rem) var(--margen) clamp(1rem, 3vw, 2rem);
    background: var(--galeria-fondo);
    scrollbar-width: none;
  }

  .galeria::-webkit-scrollbar {
    display: none;
  }

  figure {
    margin: 0;
    scroll-snap-align: start;
  }

  figure img {
    width: 100%;
  }

  /* La etiqueta va arriba de cada vista, como el texto pequeño estampado en la prenda. */
  figcaption {
    margin-bottom: 0.4rem;
    text-align: center;
    font-size: var(--t-nota);
    color: var(--galeria-tenue);
  }

  .datos {
    padding: clamp(1.75rem, 6vw, 2.5rem) var(--margen) clamp(2.5rem, 8vw, 4rem);
    background: var(--datos-fondo);
    color: var(--datos-texto);
  }

  h1 {
    font-size: clamp(2.6rem, 5.2vw, 5rem); /* único titular grande de esta página */
    line-height: 1;
  }

  .precio {
    margin-top: 0.5rem;
    font-weight: 300;
    font-size: var(--t-lead);
  }

  .descripcion {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.3;
  }

  .tallas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    border: 0;
  }

  .tallas legend {
    margin-bottom: 0.6rem;
    padding: 0;
    font-size: var(--t-nota);
  }

  .tallas label {
    position: relative;
    cursor: pointer;
  }

  .tallas input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .tallas span {
    display: grid;
    place-items: center;
    min-width: 3.1rem;
    height: 3.1rem;
    padding-inline: 0.6rem;
    background: var(--talla-fondo);
    font-weight: 600;
    font-size: var(--t-texto);
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .tallas input:checked + span {
    background: var(--datos-texto);
    color: var(--datos-fondo);
  }

  .tallas input:focus-visible + span {
    outline: 2px solid var(--datos-texto);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .tallas label:hover span {
      background: var(--datos-texto);
      color: var(--datos-fondo);
    }
  }

  .pedir {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    padding: 1.05rem 1.5rem;
    background: var(--datos-texto);
    color: var(--datos-fondo);
    font-weight: 600;
    font-size: var(--t-texto);
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .pedir svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }

  .pedir:hover {
    background: var(--datos-fondo);
    color: var(--datos-texto);
    outline: 2px solid var(--datos-texto);
    outline-offset: -2px;
  }

  .pedir:active {
    transform: translateY(1px);
  }

  .nota {
    margin-top: 0.7rem;
    font-size: var(--t-nota);
    color: var(--datos-tenue);
  }

  /* Entrada de los datos al cargar: uno tras otro y todo quieto antes de 1,2 s. */
  .datos > *,
  figure + figure {
    animation: entrar 0.45s ease-out both;
  }

  .datos > :nth-child(2) {
    animation-delay: 60ms;
  }

  .datos > :nth-child(3) {
    animation-delay: 120ms;
  }

  .datos > :nth-child(4) {
    animation-delay: 180ms;
  }

  .datos > :nth-child(5) {
    animation-delay: 240ms;
  }

  .datos > :nth-child(6) {
    animation-delay: 300ms;
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* La foto de campaña: cómo queda la prenda puesta, de frente y de espaldas. */
  .puesta {
    padding-top: clamp(4rem, 9vw, 9rem);
    background: var(--negro);
  }

  .puesta h2,
  .otras h2 {
    padding-inline: var(--margen);
    font-size: var(--t-titulo);
  }

  .puesta h2 {
    margin-bottom: clamp(1rem, 2.4vw, 2.5rem);
  }

  /* Las demás prendas: el mismo mosaico del inicio, de lado a lado, sobre Bone. */
  .otras {
    padding: clamp(4rem, 9vw, 9rem) 0 clamp(3rem, 7vw, 7rem);
    background: var(--hueso);
    color: var(--negro);
  }

  .otras ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: clamp(1.25rem, 2.6vw, 2.75rem);
  }

  .otras li:nth-child(2n) {
    --i: 1;
  }

  .volver {
    display: inline-block;
    margin: clamp(2rem, 4vw, 3.5rem) var(--margen) 0;
    font-size: var(--t-texto);
    font-weight: 600;
    text-underline-offset: 0.22em;
  }

  /* Computador: prenda a la izquierda (frente y espalda lado a lado), datos a la derecha. */
  @media (min-width: 60rem) {
    .principal {
      grid-template-columns: 3fr 2fr;
    }

    .galeria {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
      grid-auto-columns: auto;
      gap: 1vw;
      align-content: center;
      overflow: visible;
      padding: clamp(2.5rem, 4.5vw, 5rem) var(--margen);
    }

    .datos {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      padding: clamp(2.5rem, 4.5vw, 5rem) var(--margen);
    }

    .otras ul {
      grid-template-columns: repeat(4, 1fr);
    }

    .otras li:nth-child(n) {
      --i: 0;
    }

    .otras li:nth-child(4n + 2) {
      --i: 1;
    }

    .otras li:nth-child(4n + 3) {
      --i: 2;
    }

    .otras li:nth-child(4n) {
      --i: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .datos > *,
    figure + figure {
      animation: none;
    }
  }
</style>
