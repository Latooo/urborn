---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Cabecera from '../components/Cabecera.astro';
import Hero from '../components/Hero.astro';
import Coleccion from '../components/Coleccion.astro';
import Figura from '../components/Figura.astro';
import Manifiesto from '../components/Manifiesto.astro';
import Significado from '../components/Significado.astro';
import Universo from '../components/Universo.astro';
import Pie from '../components/Pie.astro';
---

<Base intro>
  <Intro />
  <Cabecera />
  <main id="contenido">
    <Hero />
    <Coleccion />
    <Figura />
    <Manifiesto />
    <Significado />
    <Universo />
  </main>
  <Pie />
</Base>
