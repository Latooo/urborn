---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Cabecera from '../components/Cabecera.astro';
import Hero from '../components/Hero.astro';
import Coleccion from '../components/Coleccion.astro';
import Figura from '../components/Figura.astro';
import Cierre from '../components/Cierre.astro';
import Afiche from '../components/Afiche.astro';
import Pie from '../components/Pie.astro';
---

<Base intro>
  <Intro />
  <Cabecera />
  <main id="contenido">
    <Hero />
    <Coleccion />
    <Afiche />
    <Figura />
    <Cierre />
  </main>
  <Pie />
</Base>
