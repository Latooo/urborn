---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Campana from '../../components/Campana.astro';
import { coleccion, enlaceWhatsapp, formatoPrecio, mensajePedido, type Producto } from '../../data/productos';
import { marca } from '../../data/sitio';
import { ruta } from '../../lib/rutas';

// Una página por camiseta: /camiseta/000/, /camiseta/001/...
export function getStaticPaths() {
  return coleccion.productos.map((producto) => ({
    params: { codigo: producto.codigo },
    props: { producto },
  }));
}

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const otras = coleccion.productos.filter((otra) => otra.codigo !== producto.codigo);

// El enlace a esta página va dentro del mensaje para que quien atiende sepa qué camiseta es.
const estaPagina = Astro.site ? Astro.url.href : undefined;
const pedido = (talla?: string) => enlaceWhatsapp(mensajePedido(producto, talla, estaPagina));

const anchos = [480, 720, 960, 1280, 1600];
const tamanos = '(min-width: 60rem) 27vw, 72vw';

// Trazo de Simple Icons (licencia CC0).
const trazoWhatsapp =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
---

<Base
  titulo={`${producto.nombre} — ${marca.nombre}`}
  descripcion={`${producto.nombre} de la colección ${coleccion.nombre}, ${formatoPrecio(producto.precio)}. Pedidos por WhatsApp.`}
>
  <Cabecera />

  <main class="ficha" id="contenido">
    <!-- Mitad negra con la prenda, mitad blanca con los datos: las mismas franjas del inicio. -->
    <div class="principal">
      <div class="galeria" id="inicio">
        <figure style={`view-transition-name: prenda-${producto.codigo}`}>
          <figcaption>frente</figcaption>
          <Image
            src={producto.frente}
            alt={`${producto.nombre}, vista de frente`}
            widths={anchos}
            sizes={tamanos}
            quality={90}
            priority
          />
        </figure>
        <figure>
          <figcaption>espalda</figcaption>
          <Image
            src={producto.espalda}
            alt={`${producto.nombre}, vista de espalda con el logo de URBORN y el cuervo`}
            widths={anchos}
            sizes={tamanos}
            quality={90}
            loading="eager"
          />
        </figure>
      </div>

      <div class="datos">
        <h1 class="titulo">{producto.nombre}</h1>
        <p class="precio">{formatoPrecio(producto.precio)}</p>
        <p class="descripcion">{producto.descripcion}</p>

        <fieldset class="tallas">
          <legend>Talla</legend>
          {
            producto.tallas.map((talla) => (
              <label>
                <input type="radio" name="talla" value={talla} data-enlace={pedido(talla)} />
                <span>{talla}</span>
              </label>
            ))
          }
        </fieldset>

        <a class="pedir" href={pedido()} target="_blank" rel="noopener" data-pedido>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={trazoWhatsapp}></path></svg>
          Pedir por WhatsApp
        </a>
        <p class="nota">Se abre el chat de URBORN con tu pedido ya escrito.</p>
      </div>
    </div>

    <section class="puesta" aria-labelledby="titulo-puesta">
      <h2 class="titulo" id="titulo-puesta" data-revelar="mascara"><span>Así se ve puesta</span></h2>
      <Campana />
    </section>

    <section class="otras" aria-labelledby="titulo-otras">
      <h2 class="titulo" id="titulo-otras" data-revelar="mascara"><span>Más de {coleccion.nombre}</span></h2>
      <ul>
        {
          otras.map((otra) => (
            <li>
              <Tarjeta producto={otra} tamanos="(min-width: 60rem) 16vw, (min-width: 44rem) 28vw, 42vw" />
            </li>
          ))
        }
      </ul>
      <a class="volver" href={ruta('#coleccion')} data-revelar>Ver toda la colección</a>
    </section>
  </main>

  <Pie />
</Base>

<script>
  // Al elegir talla, el botón de WhatsApp lleva el mensaje con esa talla.
  const boton = document.querySelector<HTMLAnchorElement>('[data-pedido]');

  for (const opcion of document.querySelectorAll<HTMLInputElement>('input[name="talla"]')) {
    opcion.addEventListener('change', () => {
      if (boton && opcion.checked && opcion.dataset.enlace) boton.href = opcion.dataset.enlace;
    });
    // Si el navegador recordó una talla marcada al volver atrás, el botón debe coincidir.
    if (boton && opcion.checked && opcion.dataset.enlace) boton.href = opcion.dataset.enlace;
  }
</script>

<style>
  .ficha {
    background: var(--negro);
  }

  .principal {
    display: grid;
  }

  /* Celular: frente y espalda en una fila que se desliza; la segunda prenda asoma a propósito. */
  .galeria {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 28rem);
    gap: 3vw;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margen);
    padding: clamp(1.25rem, 4vw, 2.5rem) var(--margen) clamp(1rem, 3vw, 2rem);
    background: var(--asfalto); /* sobre Asphalt la prenda negra se distingue */
    scrollbar-width: none;
  }

  .galeria::-webkit-scrollbar {
    display: none;
  }

  figure {
    margin: 0;
    scroll-snap-align: start;
  }

  figure img {
    width: 100%;
  }

  /* La etiqueta va arriba de cada vista, como el texto pequeño estampado en la prenda. */
  figcaption {
    margin-bottom: 0.4rem;
    text-align: center;
    font-size: var(--t-nota);
    color: var(--tenue-oscuro);
  }

  .datos {
    padding: clamp(1.75rem, 6vw, 2.5rem) var(--margen) clamp(2.5rem, 8vw, 4rem);
    background: var(--hueso);
    color: var(--negro);
  }

  h1 {
    font-size: clamp(2.6rem, 5.2vw, 5rem); /* único titular grande de esta página */
    line-height: 1;
  }

  .precio {
    margin-top: 0.5rem;
    font-weight: 300;
    font-size: var(--t-lead);
  }

  .descripcion {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.3;
  }

  .tallas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    border: 0;
  }

  .tallas legend {
    margin-bottom: 0.6rem;
    padding: 0;
    font-size: var(--t-nota);
  }

  .tallas label {
    position: relative;
    cursor: pointer;
  }

  .tallas input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .tallas span {
    display: grid;
    place-items: center;
    min-width: 3.1rem;
    height: 3.1rem;
    padding-inline: 0.6rem;
    background: #c4c0b7; /* un paso más oscuro que Bone */
    font-weight: 600;
    font-size: var(--t-texto);
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .tallas input:checked + span {
    background: var(--negro);
    color: var(--hueso);
  }

  .tallas input:focus-visible + span {
    outline: 2px solid var(--negro);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .tallas label:hover span {
      background: var(--negro);
      color: var(--hueso);
    }
  }

  .pedir {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    padding: 1.05rem 1.5rem;
    background: var(--negro);
    color: var(--hueso);
    font-weight: 600;
    font-size: var(--t-texto);
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .pedir svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }

  .pedir:hover {
    background: var(--hueso);
    color: var(--negro);
    outline: 2px solid var(--negro);
    outline-offset: -2px;
  }

  .pedir:active {
    transform: translateY(1px);
  }

  .nota {
    margin-top: 0.7rem;
    font-size: var(--t-nota);
    color: var(--tenue-claro);
  }

  /* Entrada de los datos al cargar: uno tras otro y todo quieto antes de 1,2 s. */
  .datos > *,
  figure + figure {
    animation: entrar 0.45s ease-out both;
  }

  .datos > :nth-child(2) {
    animation-delay: 60ms;
  }

  .datos > :nth-child(3) {
    animation-delay: 120ms;
  }

  .datos > :nth-child(4) {
    animation-delay: 180ms;
  }

  .datos > :nth-child(5) {
    animation-delay: 240ms;
  }

  .datos > :nth-child(6) {
    animation-delay: 300ms;
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* La foto de campaña: cómo queda la camiseta puesta, de frente y de espaldas. */
  .puesta {
    padding-top: clamp(4rem, 9vw, 9rem);
    background: var(--negro);
  }

  .puesta h2,
  .otras h2 {
    padding-inline: var(--margen);
    font-size: var(--t-titulo);
  }

  .puesta h2 {
    margin-bottom: clamp(1rem, 2.4vw, 2.5rem);
  }

  /* Las demás camisetas, sobre blanco. */
  .otras {
    --secundario: var(--tenue-claro);
    padding: clamp(4rem, 9vw, 9rem) 0 clamp(3rem, 7vw, 7rem);
    background: var(--hueso);
    color: var(--negro);
  }

  .otras ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem) clamp(1rem, 2.4vw, 2.5rem);
    margin-top: clamp(1.25rem, 2.6vw, 2.75rem);
    padding-inline: var(--margen);
  }

  .otras li:nth-child(2n) {
    --i: 1;
  }

  .volver {
    display: inline-block;
    margin: clamp(2rem, 4vw, 3.5rem) var(--margen) 0;
    font-size: var(--t-texto);
    font-weight: 600;
    text-underline-offset: 0.22em;
  }

  @media (min-width: 44rem) {
    .otras ul {
      grid-template-columns: repeat(3, 1fr);
    }

    .otras li:nth-child(2n) {
      --i: 0;
    }

    .otras li:nth-child(3n + 2) {
      --i: 1;
    }

    .otras li:nth-child(3n) {
      --i: 2;
    }
  }

  /* Computador: prenda a la izquierda (frente y espalda lado a lado), datos a la derecha. */
  @media (min-width: 60rem) {
    .principal {
      grid-template-columns: 3fr 2fr;
    }

    .galeria {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
      grid-auto-columns: auto;
      gap: 1vw;
      align-content: center;
      overflow: visible;
      padding: clamp(2.5rem, 4.5vw, 5rem) var(--margen);
    }

    .datos {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      padding: clamp(2.5rem, 4.5vw, 5rem) var(--margen);
    }

    .otras ul {
      grid-template-columns: repeat(5, 1fr);
    }

    .otras li:nth-child(n) {
      --i: 0;
    }

    .otras li:nth-child(5n + 2) {
      --i: 1;
    }

    .otras li:nth-child(5n + 3) {
      --i: 2;
    }

    .otras li:nth-child(5n + 4) {
      --i: 3;
    }

    .otras li:nth-child(5n) {
      --i: 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .datos > *,
    figure + figure {
      animation: none;
    }
  }
</style>
