---
import '@fontsource-variable/roboto-condensed';
import '@fontsource-variable/roboto-condensed/wght-italic.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import fotoHero from '../assets/img/hero-new-collection.jpg';
import { marca } from '../data/sitio';
import { ruta } from '../lib/rutas';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** La página trae la animación de entrada con el logo (solo el inicio). */
  intro?: boolean;
}

const { titulo = `${marca.nombre} — ${marca.lema}`, descripcion = marca.descripcion, intro = false } = Astro.props;

const vistaPrevia = await getImage({ src: fotoHero, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const urlVistaPrevia = Astro.site ? new URL(vistaPrevia.src, Astro.site).href : vistaPrevia.src;
// La versión de prueba en GitHub Pages no debe aparecer en buscadores.
const ocultarEnBuscadores = import.meta.env.PUBLIC_NOINDEX === 'true';
---

<!doctype html>
<html lang="es" data-intro={intro ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {ocultarEnBuscadores && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href={ruta('favicon.png')} />
    <link rel="apple-touch-icon" href={ruta('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={urlVistaPrevia} />
    <meta property="og:locale" content="es_CO" />
    {Astro.site && <meta property="og:url" content={Astro.url.href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Va en línea y antes de pintar: decide si se muestra la animación de entrada.
      Solo se muestra en el inicio, la primera vez de cada visita, y nunca si la persona
      pidió menos movimiento en su sistema.
    -->
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        var visto = false;
        try {
          visto = !!sessionStorage.getItem('urborn-visita');
          sessionStorage.setItem('urborn-visita', '1');
        } catch (e) {}
        if (visto || !raiz.hasAttribute('data-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          raiz.classList.add('sin-intro');
        }
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />

    <script>
      // Apariciones al hacer scroll: se oculta solo lo que está por debajo de la pantalla
      // al cargar y se muestra cuando entra. Lo que ya está a la vista no se toca.
      const menosMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!menosMovimiento && 'IntersectionObserver' in window) {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              entrada.target.classList.remove('oculto');
              observador.unobserve(entrada.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );

        const limite = window.innerHeight * 0.95;
        for (const elemento of document.querySelectorAll('[data-revelar]')) {
          if (elemento.getBoundingClientRect().top > limite) {
            elemento.classList.add('oculto');
            observador.observe(elemento);
          }
        }
      }
    </script>
  </body>
</html>
