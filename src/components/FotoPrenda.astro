---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Anchos que se generan; el navegador toma el que necesita según la pantalla. */
  widths: number[];
  /** Ancho con que se ve la prenda. Si se queda corto, el navegador amplía una imagen pequeña y se ve borrosa. */
  sizes: string;
  class?: string;
  priority?: boolean;
  loading?: 'eager' | 'lazy';
}

const { class: clase, ...props } = Astro.props;
---

<!--
  Foto de una prenda. Sale en AVIF, que guarda el color a resolución completa (el rojo de los
  estampados queda nítido) y pesa menos; WebP queda de respaldo para navegadores viejos.
-->
<Picture {...props} class={clase} formats={['avif']} fallbackFormat="webp" quality={90} />
