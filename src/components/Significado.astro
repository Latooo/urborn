---
import { marca, significado } from '../data/sitio';
---

<!-- De dónde sale el nombre: URBAN + BORN. Textos del cliente. -->
<section class="significado" aria-labelledby="titulo-significado">
  <h2 class="titulo" id="titulo-significado" data-revelar="mascara"><span>Urban + Born</span></h2>

  <div class="texto">
    <p class="concepto" data-revelar>{marca.concepto}</p>
    {
      significado.map((parte, i) => (
        <p class="parte" data-revelar style={`--i: ${i + 1}`}>
          <strong class="titulo">{parte.palabra}</strong> {parte.texto}
        </p>
      ))
    }
  </div>
</section>

<style>
  .significado {
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
    padding: clamp(4rem, 9vw, 9rem) var(--margen);
    background: var(--hueso);
    color: var(--negro);
  }

  h2 {
    font-size: var(--t-display);
  }

  .concepto {
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .parte {
    margin-top: clamp(1.25rem, 2.2vw, 2rem);
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.35;
    color: var(--tenue-claro);
  }

  .parte strong {
    margin-right: 0.15em;
    color: var(--negro);
  }

  @media (min-width: 44rem) {
    .significado {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
