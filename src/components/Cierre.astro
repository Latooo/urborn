---
import { Picture } from 'astro:assets';
import afiche from '../assets/img/afiche-the-origin.jpg';
import { manifiesto } from '../data/sitio';
import { ruta } from '../lib/rutas';
---

<!--
  Cierre del inicio: el afiche de The Origin, que ya trae la frase de la marca, y el paso al
  manifiesto completo. El botón va en el espacio vacío de arriba a la izquierda del afiche.
  El afiche se sirve tal como lo mandó el cliente; su fondo blanco se ve Bone porque se multiplica
  con el fondo de la sección (así no queda un recuadro blanco). Sale en AVIF, que conserva el grano
  de la foto mucho mejor que WebP.
-->
<section class="cierre" aria-labelledby="titulo-cierre">
  <h2 class="solo-lector" id="titulo-cierre">{manifiesto.titulo}</h2>
  <Picture
    src={afiche}
    alt="Modelo con la camiseta A[R]T y los brazos abiertos, junto al texto The Origin. We were never made to fit in."
    widths={[640, 960, 1280, 1680, 2100, 2576]}
    sizes="100vw"
    formats={['avif']}
    fallbackFormat="webp"
    quality={90}
  />
  <p class="paso"><a class="boton" href={ruta('marca/')}>Leer el manifiesto</a></p>
</section>

<style>
  .cierre {
    position: relative;
    isolation: isolate;
    background: var(--hueso);
  }

  img {
    width: 100%;
    mix-blend-mode: multiply;
  }

  .paso {
    position: absolute;
    top: var(--margen);
    left: var(--margen);
  }

  /* El botón global es para fondo oscuro; aquí va invertido. */
  .boton {
    background: var(--negro);
    color: var(--hueso);
  }

  .boton:hover {
    background: var(--hueso);
    color: var(--negro);
    outline-color: var(--negro);
  }
</style>
