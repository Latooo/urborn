---
import { manifiesto } from '../data/sitio';
---

<!-- El manifiesto de la marca, tal como lo entregó el cliente. Sigue a la figura sin corte de color. -->
<section class="manifiesto" id="manifiesto" aria-labelledby="titulo-manifiesto">
  <h2 class="titulo" id="titulo-manifiesto" data-revelar="mascara"><span>{manifiesto.titulo}</span></h2>

  <ul>
    {
      manifiesto.puntos.map((punto) => (
        <li data-revelar>
          <h3 class="titulo">{punto.titulo}</h3>
          <p>{punto.texto}</p>
        </li>
      ))
    }
  </ul>

  <p class="titulo cierre" data-revelar="mascara"><span>{manifiesto.cierre}</span></p>
</section>

<style>
  .manifiesto {
    padding: clamp(3rem, 7vw, 7rem) var(--margen) clamp(4.5rem, 10vw, 10rem);
    background: var(--negro);
  }

  /* En celular va un poco más pequeño que el titular del hero para que quepa en dos líneas. */
  h2,
  .cierre {
    font-size: calc(var(--t-display) * 0.74);
    text-wrap: balance;
  }

  ul {
    display: grid;
    gap: clamp(1.75rem, 3.4vw, 3.5rem);
    margin-block: clamp(2.5rem, 6vw, 6rem);
  }

  h3 {
    font-size: var(--t-titulo);
  }

  li p {
    margin-top: 0.5rem;
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.35;
  }

  /* Computador: cada idea en una fila, la frase a la izquierda y su explicación a la derecha. */
  @media (min-width: 60rem) {
    h2,
    .cierre {
      font-size: var(--t-display);
    }

    li {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: var(--margen);
      align-items: baseline;
    }

    li p {
      margin-top: 0;
    }
  }
</style>
