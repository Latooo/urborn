---
import { manifiesto } from '../data/sitio';
---

<!-- El manifiesto de la marca, tal como lo entregó el cliente. Abre la página /marca/, por eso su título es el h1. -->
<section class="manifiesto" id="inicio" aria-labelledby="titulo-manifiesto">
  <h1 class="titulo" id="titulo-manifiesto">{manifiesto.titulo}</h1>

  <ul>
    {
      manifiesto.puntos.map((punto, i) => (
        <li style={`--i: ${i}`}>
          <h2 class="titulo">{punto.titulo}</h2>
          <p>{punto.texto}</p>
        </li>
      ))
    }
  </ul>

  <p class="titulo cierre" style={`--i: ${manifiesto.puntos.length}`}>{manifiesto.cierre}</p>
</section>

<style>
  .manifiesto {
    padding: clamp(3rem, 7vw, 7rem) var(--margen) clamp(4.5rem, 10vw, 10rem);
    background: var(--negro);
  }

  /* En celular va un poco más pequeño que el titular del hero para que quepa en dos líneas. */
  h1,
  .cierre {
    font-size: calc(var(--t-display) * 0.74);
    text-wrap: balance;
  }

  /*
   * Es la primera pantalla de la página: el título está desde el comienzo y las ideas entran
   * una tras otra al cargar.
   */
  @media (prefers-reduced-motion: no-preference) {
    li,
    .cierre {
      animation: llegar 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) calc(0.12s + var(--i) * 0.07s) both;
    }
  }

  @keyframes llegar {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  ul {
    display: grid;
    gap: clamp(1.75rem, 3.4vw, 3.5rem);
    margin-block: clamp(2.5rem, 6vw, 6rem);
  }

  h2 {
    font-size: var(--t-titulo);
  }

  li p {
    margin-top: 0.5rem;
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.35;
  }

  /* Computador: cada idea en una fila, la frase a la izquierda y su explicación a la derecha. */
  @media (min-width: 60rem) {
    h1,
    .cierre {
      font-size: var(--t-display);
    }

    li {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: var(--margen);
      align-items: baseline;
    }

    li p {
      margin-top: 0;
    }
  }
</style>
