---
import Tarjeta from './Tarjeta.astro';
import { coleccion, proximoDrop } from '../data/productos';
---

<section class="coleccion" id="coleccion" aria-labelledby="titulo-coleccion">
  <h2 class="titulo" id="titulo-coleccion" data-revelar="mascara"><span>{coleccion.nombre}</span></h2>

  <ul class="rejilla">
    {
      coleccion.productos.map((producto) => (
        <li>
          <Tarjeta producto={producto} />
        </li>
      ))
    }
    <li>
      <Tarjeta proximo={proximoDrop} />
    </li>
  </ul>
</section>

<style>
  .coleccion {
    background: var(--asfalto);
    padding-top: clamp(1.75rem, 4vw, 4rem);
  }

  h2 {
    padding-inline: var(--margen);
    margin-bottom: clamp(0.6rem, 1.4vw, 1.5rem);
    font-size: var(--t-titulo);
  }

  /*
   * Mosaico de lado a lado, sin separación: todas las tarjetas van sobre Bone (ver Tarjeta.astro),
   * así la colección es un solo campo de color. Las prendas de una fila entran una tras otra (--i).
   */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  li:nth-child(2n) {
    --i: 1;
  }

  /* Computador, 3 columnas. */
  @media (min-width: 44rem) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
    }

    li:nth-child(n) {
      --i: 0;
    }

    li:nth-child(3n + 2) {
      --i: 1;
    }

    li:nth-child(3n) {
      --i: 2;
    }
  }
</style>
