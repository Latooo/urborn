---
import FotoPrenda from './FotoPrenda.astro';
import { formatoPrecio, type Producto, type ProximoDrop } from '../data/productos';
import { ruta } from '../lib/rutas';

interface Props {
  /** La prenda que muestra la tarjeta. */
  producto?: Producto;
  /** En lugar de una prenda: la tarjeta del siguiente drop, que no lleva a ninguna página. */
  proximo?: ProximoDrop;
  /** Ancho con que se ve la prenda, para que el navegador pida la imagen del tamaño justo. */
  tamanos?: string;
}

// El ancho real de la prenda es un tercio (computador) o la mitad (celular) menos los márgenes de la tarjeta.
const { producto, proximo, tamanos = '(min-width: 44rem) 26vw, 42vw' } = Astro.props;
const anchos = [240, 360, 480, 720, 960, 1280];
---

<!--
  Tarjeta de una prenda: lleva a su página. Frente y espalda van apilados y al pasar el cursor
  (o enfocar con teclado) se ve la espalda. Todas las tarjetas van sobre el mismo fondo, como en la
  tienda de referencia: la colección se lee como un solo bloque.
-->
<div class="tarjeta">
  {
    producto && (
      <a class="enlace" href={ruta(`prenda/${producto.codigo}/`)} data-revelar>
        <span class="fotos" style={`view-transition-name: prenda-${producto.codigo}`}>
          <FotoPrenda
            class="frente"
            src={producto.frente}
            alt={`${producto.nombre}, vista de frente`}
            widths={anchos}
            sizes={tamanos}
          />
          <FotoPrenda class="espalda" src={producto.espalda} alt="" widths={anchos} sizes={tamanos} />
        </span>
        <h3 class="titulo">{producto.nombre}</h3>
        <p class="precio">{formatoPrecio(producto.precio)}</p>
      </a>
    )
  }
  {
    proximo && (
      <div class="enlace" data-revelar>
        <span class="fotos">
          <FotoPrenda src={proximo.imagen} alt="" widths={anchos} sizes={tamanos} />
        </span>
        <h3 class="titulo">{proximo.titulo}</h3>
        <p class="precio">{proximo.aviso}</p>
      </div>
    )
  }
</div>

<style>
  .tarjeta {
    --secundario: var(--tenue-claro);
    height: 100%;
    /* Mismo margen de la página: el nombre de la primera columna queda alineado con los títulos. */
    padding: clamp(1rem, 2.4vw, 2.5rem) var(--margen) clamp(1.4rem, 3vw, 3.25rem);
    background: var(--hueso);
    color: var(--negro);
  }

  .enlace {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .fotos {
    position: relative;
    display: block;
  }

  .fotos img {
    width: 100%;
    transition: opacity 0.3s ease;
  }

  .espalda {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .enlace:focus-visible .frente {
    opacity: 0;
  }

  .enlace:focus-visible .espalda {
    opacity: 1;
  }

  @media (hover: hover) {
    .enlace:hover .frente {
      opacity: 0;
    }

    .enlace:hover .espalda {
      opacity: 1;
    }
  }

  h3 {
    margin-top: 0.45em;
    font-size: var(--t-lead);
    line-height: 1.05;
  }

  .precio {
    font-weight: 300;
    font-size: var(--t-texto);
    line-height: 1.3;
    color: var(--secundario);
  }
</style>
