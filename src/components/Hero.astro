---
import { Image } from 'astro:assets';
import foto from '../assets/img/hero-new-collection.jpg';
import { PRECIOS_VISIBLES, coleccion, formatoPrecio } from '../data/productos';
import { marca } from '../data/sitio';

// El lema se repite dos veces seguidas para que la franja gire sin cortes.
const copias = Array.from({ length: 2 });
const repeticiones = Array.from({ length: 8 });

// Precio que se anuncia en la portada: el de todas si es el mismo, o "desde" el menor. Nada si aún no hay precios.
const precios = coleccion.productos.map((producto) => producto.precio);
const menor = Math.min(...precios);
const precio = precios.every((valor) => valor === menor) ? formatoPrecio(menor) : `desde ${formatoPrecio(menor)}`;
const frase = `Camisetas y crop tops de la colección ${coleccion.nombre}${PRECIOS_VISIBLES ? `, ${precio}` : ''}.`;
---

<!-- La franja del lema va dentro de los mismos márgenes que la barra, como en el diseño. -->
<div class="lema" aria-hidden="true">
  <div class="ventana">
    <div class="pista">
      {copias.map(() => <ul>{repeticiones.map(() => <li>{marca.lema}</li>)}</ul>)}
    </div>
  </div>
</div>

<div class="portada">
  <section class="hero" id="inicio">
    <!--
      La foto se recorta con object-fit: en celular se ve más ancha que la pantalla,
      por eso "sizes" pide una imagen más grande ahí (si no, se ve borrosa).
    -->
    <Image
      class="foto"
      src={foto}
      alt="Dos modelos con la camiseta The Origin de URBORN, uno de frente y otro de espaldas con el estampado del cuervo."
      widths={[640, 960, 1280, 1680, 2100, 2560, 3200]}
      sizes="(max-width: 44rem) 190vw, 100vw"
      quality={90}
      priority
    />

    <h1 class="titular">
      <span class="linea"><span class="titulo grande">New collection</span></span>
      <span class="linea"><span class="chico">URBORN.STUDIO<sup>®</sup></span></span>
    </h1>
  </section>

  <!--
    Agregado sobre el diseño del cliente: dice en palabras simples qué es esto y cuánto cuesta,
    y da un botón hacia las camisetas. En computador cierra la esquina derecha de la foto;
    en celular va justo debajo.
  -->
  <div class="resumen">
    <p>{frase}</p>
    <a class="boton" href="#coleccion">Ver la colección</a>
  </div>
</div>

<style>
  .lema {
    padding: 0.38em var(--margen);
    background: var(--asfalto);
    color: var(--tenue-oscuro);
    font-size: var(--t-nota);
    line-height: 1;
    white-space: nowrap;
  }

  .ventana {
    overflow: hidden;
  }

  .pista {
    display: flex;
    width: max-content;
    animation: correr 60s linear infinite;
  }

  .pista ul {
    display: flex;
    gap: 0.9em;
    padding-right: 0.9em;
  }

  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }

  .portada {
    position: relative;
    background: var(--negro);
    timeline-scope: --hero;
  }

  .hero {
    position: relative;
    overflow: hidden;
    /* Proporción del diseño en computador; en celular queda casi cuadrado para que quepan los dos modelos. */
    height: clamp(22rem, 49.2vw, 86svh);
    background: var(--negro);
    view-timeline-name: --hero;
  }

  .foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 47% 58%;
  }

  /* Velo neutro en la base de la foto para que el texto se lea sobre el muro gris. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 50% 0 0;
    background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.42)); /* taste-skill-ignore */
    pointer-events: none;
  }

  .titular {
    --chico: var(--t-titulo);
    position: absolute;
    z-index: 1;
    left: var(--margen);
    bottom: clamp(1rem, 3.1vw, 3rem);
    font-weight: inherit;
  }

  /* Cada línea del titular sube desde detrás de una máscara al cargar. Todo queda quieto antes de 1,2 s. */
  .linea {
    display: block;
    overflow: hidden;
    padding-right: 0.4em; /* para que la máscara no corte la ® ni el borde de la última letra */
  }

  .linea + .linea {
    margin-top: calc(var(--chico) * 0.02);
  }

  .linea > span {
    display: block;
    animation: subir 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) var(--espera-intro, 0.1s) both;
  }

  .linea + .linea > span {
    animation-delay: calc(var(--espera-intro, 0.1s) + 0.07s);
  }

  @keyframes subir {
    from {
      transform: translateY(110%);
    }
  }

  .grande {
    font-size: var(--t-display);
    line-height: 0.98;
  }

  .chico {
    font-size: var(--chico);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .chico sup {
    font-size: 0.26em;
    vertical-align: top;
    position: relative;
    top: 0.55em;
    margin-left: 0.15em;
    letter-spacing: 0;
  }

  /* Qué es y qué hacer: en celular y tablet va debajo de la foto. */
  .resumen {
    padding: 1.1rem var(--margen) 0.4rem;
    font-size: var(--t-lead);
    line-height: 1.22;
    text-wrap: balance;
  }

  .resumen > * {
    animation: llegar 0.45s ease-out calc(var(--espera-intro, 0.1s) + 0.16s) both;
  }

  .resumen > .boton {
    margin-top: 0.85rem;
    animation-delay: calc(var(--espera-intro, 0.1s) + 0.22s);
  }

  @keyframes llegar {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* Computador: el resumen se monta sobre la foto, abajo a la derecha, a la misma altura del titular. */
  @media (min-width: 60rem) {
    .resumen {
      position: absolute;
      z-index: 1;
      right: var(--margen);
      bottom: clamp(1rem, 3.1vw, 3rem);
      padding: 0;
      max-width: 17em;
      text-align: right;
    }
  }

  /*
   * Movimiento ligado al scroll (solo navegadores que lo soportan; en los demás queda quieto):
   * al bajar, la foto se queda atrás y los textos se adelantan y se desvanecen.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .foto {
        animation: quedarse linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      .titular {
        animation: adelantarse linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 75%;
      }
    }

    @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
      .resumen {
        animation: adelantarse linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 75%;
      }
    }
  }

  @keyframes quedarse {
    to {
      transform: translateY(22%);
    }
  }

  @keyframes adelantarse {
    to {
      transform: translateY(-45%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista,
    .linea > span,
    .resumen > * {
      animation: none;
    }
  }
</style>
